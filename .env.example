# 飞书群机器人 Webhook（卡片推送）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxxx
FEISHU_WEBHOOK_SECRET=your_webhook_secret_here

# 飞书开放应用（多维表格归档）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxx

# 推送时段（morning / evening）
PUSH_SESSION=morning
